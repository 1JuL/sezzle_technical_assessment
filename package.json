{
  "name": "sezzle_technical_assessment",
  "version": "1.0.0",
  "description": "Full-stack calculator application",
  "private": true,
  "homepage": "https://github.com/1JuL/sezzle_technical_assessment#readme",
  "author": "diego_diaz",
  "license": "ISC",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run start --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev": "npm start",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "build": "npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
